+            if self._override:
+                self._override["from_cache"] = True
+            self._touch()
+
+    # -- events from CrewAI --------------------------------------------------
+    def agent_started(self, key: str, context=None, att=None):
+        with self._lock:
+            st = self.agents.get(key)
+            if st is None or (att is not None and att != self.attempt):
+                return
+            w = _words(context) if context else 0
+            tail = f" · {w} words" if w else ""
+            if key != "researcher":
+                if key == "seo_editor":
+                    st.inputs = ["Blog Writer output (blog draft)" + tail]
+                elif key == "fact_checker":
+                    got = ["Research Package"] + [n for k2, n in (("blog_writer", "Blog Draft"), ("linkedin_writer", "LinkedIn Post"),
+                                                               ("twitter_writer", "Twitter/X Thread")) if self.agents[k2].status != "skipped"]
+                    if self.agents["seo_editor"].status != "skipped":
+                        got = [g if g != "Blog Draft" else "SEO-polished Blog" for g in got]
+                    st.inputs = ["Research + generated content: " + ", ".join(got) + tail]
+                else:
+                    st.inputs = ["Research Package" + tail]
+                st.activity = {"blog_writer": "Generating the blog post", "linkedin_writer": "Creating the LinkedIn post",
+                               "twitter_writer": "Creating the Twitter/X thread",
+                               "seo_editor": "Optimising the blog and writing SEO metadata",
+                               "fact_checker": "Verifying claims"}.get(key, "Working")
+            else:
+                st.activity = f"Writing the research package from {self.sources} sources" if self.sources else "Writing the research package"
+            st.status = "running"
+            st.started_at = st.started_at or time.time()
+            self._touch()
+
+    def agent_completed(self, key: str, raw, att=None):
+        with self._lock:
+            st = self.agents.get(key)
+            if st is None or st.status == "completed" or (att is not None and att != self.attempt):
+                return
+            raw = raw if isinstance(raw, str) else getattr(raw, "raw", "") or str(raw or "")
+            info = summarize_output(key, raw, self.sources)
+            st.status, st.activity, st.error = "completed", "", ""
+            st.output, st.metrics, st.preview = info["summary"], info["metrics"], info["preview"]
+            st.completed_at = time.time()
+            st.duration = st.completed_at - (st.started_at or st.completed_at)
+            if key == "researcher":
+                self.package = dict(info["metrics"])
+            self._touch()
+
+    def agent_failed(self, key: str, exc, att=None):
+        with self._lock:
+            st = self.agents.get(key)
+            if st is None or (att is not None and att != self.attempt):
+                return
+            st.status, st.error, st.activity = "failed", safe_error(exc), ""
+            st.completed_at = time.time()
+            st.duration = st.completed_at - (st.started_at or st.completed_at)
+            self._touch()
+
+    def on_task_output(self, output, att=None):
+        """Crew-level task_callback. Safety net: completes an agent whose execute_task hook did not fire."""
+        key = ROLE_TO_KEY.get(str(getattr(output, "agent", "") or ""))
+        if key:
+            self.agent_completed(key, getattr(output, "raw", "") or "", att)
+
+    # -- read side -----------------------------------------------------------
+    def snapshot(self) -> dict:
+        with self._lock:
+            if self._override is not None:
+                return copy.deepcopy(self._override)
+            end = self.finished_at or time.time()
+            return dict(
+                version=self.version, topic=self.cfg.get("topic", ""), audience=self.cfg.get("audience", ""),
+                keywords=self.cfg.get("keywords", ""), language=self.cfg.get("language", ""),
+                selected=sorted(self.cfg.get("outputs") or []), model=self.model, fallbacks=list(self.fallbacks),
+                stage=self.stage, stage_note=self.stage_note, error=self.error, sources=self.sources,
+                package=dict(self.package), from_cache=False,
+                elapsed=(end - self.started_at) if self.started_at else 0.0,
+                agents=[dataclasses.asdict(self.agents[k]) for k in AGENT_ORDER])
+
