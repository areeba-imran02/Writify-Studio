+class RunTracker:
+    """Thread-safe runtime state of one run. CrewAI writes to it (possibly from several threads: async tasks run in
+    threads); the UI only reads snapshot(). `version` increases on every change so the UI can redraw only when needed."""
+
+    def __init__(self):
+        self._lock = threading.RLock()
+        self.version = 0
+        self.attempt = 0   # bumped per model attempt: late events from an abandoned attempt are ignored
+        self._override = None
+        self._reset_all({})
+
+    # -- lifecycle -----------------------------------------------------------
+    def _touch(self):
+        self.version += 1
+
+    def _reset_all(self, cfg: dict):
+        self.cfg = dict(cfg)
+        self.stage, self.stage_note, self.model, self.error = "idle", "", "", ""
+        self.fallbacks: list = []
+        self.sources = 0
+        self.package: dict = {}
+        self.started_at = self.finished_at = None
+        self._build_agents()
+
+    def _build_agents(self):
+        outputs = set(self.cfg.get("outputs") or [])
+        sel = resolve_outputs(outputs)
+        planned = {"researcher": True, "blog_writer": "blog" in sel, "linkedin_writer": "linkedin" in sel,
+                   "twitter_writer": "twitter" in sel, "seo_editor": "seo" in sel, "fact_checker": "factcheck" in sel}
+        why = {
+            "researcher": "Research is the first step of every run. All other agents work from its research package.",
+            "blog_writer": "Your selected deliverables include a blog post." if "blog" in outputs
+                           else "SEO optimisation needs a blog draft, so the Blog Writer runs in the background.",
+            "linkedin_writer": "Your selected deliverables include LinkedIn content.",
+            "twitter_writer": "Your selected deliverables include a Twitter/X thread.",
+            "seo_editor": "SEO optimisation requires the generated blog draft.",
+            "fact_checker": "Fact-check is selected: claims are verified against the research and the generated content.",
+        }
+        self.agents = {}
+        for k in AGENT_ORDER:
+            meta = AGENT_META[k]
+            st = AgentState(key=k, name=meta["name"], role=meta["role"], phase=meta["phase"], task=meta["task"])
+            if planned[k]:
+                st.why = why[k]
+                st.hidden = k == "blog_writer" and "blog" not in outputs
+            else:
+                st.status, st.why, st.output = "skipped", "Not selected", "Not selected"
+            self.agents[k] = st
+        if self.cfg:
+            r = self.agents["researcher"]
+            r.inputs = ["Topic: " + str(self.cfg.get("topic", ""))[:120], "Audience: " + str(self.cfg.get("audience", "")),
+                        "Keywords: " + (self.cfg.get("keywords") or "chosen automatically"),
+                        "Language: " + str(self.cfg.get("language", ""))]
+
+    def new_run(self, cfg: dict):
+        """Start of a user request (before the model loop)."""
+        with self._lock:
+            self._override = None
+            self._reset_all(cfg)
+            self.stage, self.started_at = "search", time.time()
+            self._touch()
+
+    def begin_attempt(self, model: str):
+        """Start of one attempt on one model. A model fallback re-runs everything, so agent states restart."""
+        with self._lock:
+            self.attempt += 1
+            self._build_agents()
+            self.model = model.split("/")[-1]
+            self.stage, self.stage_note, self.sources, self.package, self.error = "search", "", 0, {}, ""
+            now = time.time()
+            r = self.agents["researcher"]
+            r.status, r.started_at, r.activity = "running", now, "Searching the web for evidence"
+            self._touch()
+
+    def note_fallback(self, model: str, exc):
+        with self._lock:
+            self.fallbacks.append(f"{model.split('/')[-1]}: {safe_error(exc)}")
+            self._touch()
+
+    def set_stage(self, stage: str, note: str = ""):
+        with self._lock:
+            self.stage, self.stage_note = stage, note
+            self._touch()
+
+    def set_sources(self, n: int):
+        with self._lock:
+            self.sources = n
+            r = self.agents["researcher"]
+            r.inputs = [i for i in r.inputs if not i.startswith("Evidence:")] + [f"Evidence: {n} real search sources"]
+            r.activity = f"Writing the research package from {n} sources"
+            self._touch()
+
+    def update(self, key: str, **fields):
+        """Generic state update (see update_agent_state)."""
+        with self._lock:
+            st = self.agents.get(key)
+            if st is not None:
+                for k, v in fields.items():
