+class TrackedAgent(Agent):
+    """A normal CrewAI Agent that reports when its task REALLY starts, completes or fails.
+    Task._execute_core() calls agent.execute_task() for sync tasks and (inside a worker thread) for async tasks,
+    so parallel writers are reported as running at the same time exactly when CrewAI starts them."""
+
+    _tracker: Any = PrivateAttr(default=None)
+    _key: str = PrivateAttr(default="")
+    _att: Any = PrivateAttr(default=None)
+
+    def execute_task(self, task, *args, **kwargs):
+        tr, key = self._tracker, self._key
+        if tr is None or not key:
+            return super().execute_task(task, *args, **kwargs)
+        context = kwargs.get("context", args[0] if args else None)
+        tr.agent_started(key, context if isinstance(context, str) else None, self._att)
+        try:
+            result = super().execute_task(task, *args, **kwargs)
+        except Exception as e:  # noqa: BLE001
+            tr.agent_failed(key, e, self._att)
+            raise
+        tr.agent_completed(key, result, self._att)
+        return result
+
