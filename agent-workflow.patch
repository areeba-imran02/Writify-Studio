+# ---------------------------------------------------------------- agent workflow
+# Presentation only. Everything below reads a snapshot() of crew_setup.RunTracker, which is changed by REAL CrewAI
+# task events. Nothing here invents a status, a number or a duration.
+STATUS_LABEL = {"pending": "PENDING", "running": "RUNNING", "completed": "COMPLETED", "skipped": "SKIPPED", "failed": "FAILED"}
+WAITS_FOR = {"researcher": "User query", "blog_writer": "Research Package", "linkedin_writer": "Research Package",
+             "twitter_writer": "Research Package", "seo_editor": "Blog Writer output", "fact_checker": "Research + generated content"}
+PHASE_AGENTS = [["researcher"], ["blog_writer", "linkedin_writer", "twitter_writer"], ["seo_editor"], ["fact_checker"]]
+
+
+def _e(x) -> str:
+    return html.escape(str(x), quote=True)
+
+
+def _by_key(wf: dict) -> dict:
+    return {a["key"]: a for a in wf["agents"]}
+
+
+def _dur(d) -> str:
+    return f"{d:.1f}s" if isinstance(d, (int, float)) else ""
+
+
+def render_agent_status(status: str) -> str:
+    return f'<span class="wf-badge b-{status}"><i></i>{STATUS_LABEL.get(status, status.upper())}</span>'
+
+
+def get_agent_summary(a: dict) -> list:
+    """Short facts taken from the agent's real output (empty until it completed)."""
+    m, k, out = a.get("metrics") or {}, a["key"], []
+    if a["status"] != "completed":
+        return out
+    if k == "researcher":
+        out.append(f"{m.get('sources', 0)} sources")
+        if m.get("findings"):
+            out.append(f"{m['findings']} key findings")
+    elif k == "blog_writer":
+        out.append(f"{m.get('words', 0)} words")
+        out.append(f"{m.get('headings', 0)} headings")
+    elif k == "linkedin_writer":
+        out += [f"{m.get('words', 0)} words", f"{m.get('hashtags', 0)} hashtags"]
+    elif k == "twitter_writer":
+        out += [f"{m.get('tweets', 0)} tweets", f"{m.get('words', 0)} words"]
+    elif k == "seo_editor":
+        out.append(f"{m.get('words', 0)} words")
+        out += list(m.get("fields") or [])
+    elif k == "fact_checker":
+        out.append(f"{m.get('claims', 0)} claims checked")
+        if m.get("score"):
+            out.append(f"score {m['score']}")
+        out += [f"{m[x]} {x}" for x in ("verified", "unverified", "incorrect") if m.get(x)]
+    return out
+
+
+def _next_targets(wf: dict, key: str) -> list:
+    A = _by_key(wf)
+
+    def on(k):
+        return A[k]["status"] != "skipped"
+    names = lambda ks: [AGENT_META[k]["name"] for k in ks if on(k)]  # noqa: E731
+    if key == "researcher":
+        t = names(["blog_writer", "linkedin_writer", "twitter_writer", "fact_checker"])
+    elif key == "blog_writer":
+        t = names(["seo_editor"]) or names(["fact_checker"])
+    elif key in ("linkedin_writer", "twitter_writer", "seo_editor"):
+        t = names(["fact_checker"])
+    else:
+        t = []
+    return t or ["Final Package"]
+
+
+def edge_state(src_status: str, dst_status: str) -> str:
+    """Connector state. 'flow' (animated) only while the RECEIVING agent is really running with its input delivered."""
+    if dst_status == "skipped":
+        return "skip"
+    if dst_status == "failed":
+        return "fail"
+    if dst_status == "running":
+        return "flow" if src_status == "completed" else "idle"
+    if dst_status == "completed":
+        return "done"
+    return "ready" if src_status == "completed" else "idle"
+
+
+def render_data_handoff(label, state: str, detail: str = "", to: str = "") -> str:
+    chip = ""
+    if label:
+        chip = (f'<span class="chip"><b>{_e(label)}</b>' + (f"<em>{_e(detail)}</em>" if detail else "")
+                + (f"<u>TO {_e(to).upper()}</u>" if to else "") + "</span>")
+    return f'<div class="wf-cn c-{state}"><i class="ln"></i>{chip}<i class="ln ln2"></i></div>'
+
+
+def render_agent_card(a: dict, wf: dict) -> str:
+    st, k = a["status"], a["key"]
+    meta = AGENT_META[k]
+    h = [f'<div class="wf-card s-{st}">',
+         f'<div class="wf-ch"><span class="wf-ic">{"&#10003;" if st == "completed" else meta["abbr"]}</span>'
+         f'<div><b>{_e(a["name"])}</b><small>{_e(a["role"])}</small></div>{render_agent_status(st)}</div>']
+    if st == "running":
+        h.append('<span class="wf-active">ACTIVE AGENT</span>')
+    if a.get("hidden"):
+        h.append('<span class="wf-bg">Background step for SEO</span>')
+    if st == "skipped":
+        h.append('<div class="wf-skiptxt">Not selected</div>')
+    else:
+        h.append(f'<div><div class="wf-k">Task</div><div class="wf-v">{_e(a["activity"] if st == "running" and a["activity"] else a["task"])}</div></div>')
+        h.append(f'<div class="wf-why"><b>Why</b> {_e(a["why"])}</div>')
+        if a["inputs"] and st != "pending":
+            items = "".join(f"<li>{_e(i)}</li>" for i in a["inputs"])
+            h.append(f'<div><div class="wf-k">Input</div><div class="wf-v"><ul>{items}</ul></div></div>')
+        elif st == "pending":
+            h.append(f'<div><div class="wf-k">Waits for</div><div class="wf-v">{_e(WAITS_FOR[k])}</div></div>')
+        if st == "running":
