+        return "Not enough real sources were found for this topic."
+    if "429" in m or "quota" in m or "resource_exhausted" in m or "rate limit" in m:
+        return "The model reached its rate or quota limit."
+    if "503" in m or "unavailable" in m or "high demand" in m:
+        return "The model is busy right now."
+    if "404" in m or "not_found" in m:
+        return "The selected model is not available."
+    if "api key" in m or "401" in m or "403" in m or "permission" in m:
+        return "The API key was rejected."
+    if "timeout" in m or "timed out" in m:
+        return "The request timed out."
+    return "The task could not be completed."
